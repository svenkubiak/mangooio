<?xml version="1.0" encoding="UTF-8"?>
<!-- Logging of SmokeTest.java (MongoDB driver), written to a file so the console only shows the progress -->
<Configuration>
	<Appenders>
		<File name="File" fileName="${sys:smoke.log}" append="true">
			<PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n" />
		</File>
	</Appenders>
	<Loggers>
		<Root level="info">
			<AppenderRef ref="File" />
		</Root>
	</Loggers>
</Configuration>
